    "def get_sector_mappings(basis_c: FixedBasis, N_up: int, N_dn: int):\n",
    "    \"\"\"\n",
    "    Extracts the subsystem bases and FCI mappings for a specific (N_up, N_dn) sector.\n",
    "    \"\"\"\n",
    "    mask_up_spins = sum(1 << i for i in range(0, basis_c.d, 2))\n",
    "    \n",
    "    # 1. Identify indices in the full canonical basis belonging to this sector\n",
    "    idx_sector = []\n",
    "    for idx, ket_mask in enumerate(basis_c.num_ele):\n",
    "        n_up_in_ket = bin(int(ket_mask) & mask_up_spins).count('1')\n",
    "        if n_up_in_ket == N_up:\n",
    "            idx_sector.append(idx)\n",
    "            \n",
    "    # ---> CRITICAL FIX: Early exit if the sector is entirely empty <---\n",
    "    # (Prevents NumPy from defaulting to an empty float64 array)\n",
    "    if not idx_sector:\n",
    "        return np.array([], dtype=np.int64), None, None, {}\n",
    "            \n",
    "    # Enforce integer type for safe NumPy slicing\n",
    "    idx_sector_arr = np.array(idx_sector, dtype=np.int64)\n",
    "    \n",
    "    # 2. Create specialized UP and DOWN bases for this specific sector\n",
    "    basis_sector = FixedBasis.from_subset(basis_c, idx_sector_arr)\n",
    "    basis_up = FixedBasis(d=basis_c.d // 2, num=N_up)\n",
    "    basis_dn = FixedBasis(d=basis_c.d // 2, num=N_dn)\n",
    "    \n",
    "    # 3. Build mapping (i_up, j_dn) -> (sector_idx, fermionic_sign)\n",
    "    sub2idx = {}\n",
    "    for k, op in enumerate(basis_sector.base):\n",
    "        mask_up, mask_dn = 0, 0\n",
    "        try:\n",
    "            indices = sorted([p for p, _ in next(iter(op.terms.keys()))])\n",
    "        except StopIteration:\n",
    "            continue\n",
    "            \n",
    "        down_indices = []\n",
    "        for p in indices:\n",
    "            spatial_idx = p // 2\n",
    "            if p % 2 == 0:\n",
    "                mask_up |= 1 << spatial_idx\n",
    "            else:\n",
    "                mask_dn |= 1 << spatial_idx\n",
    "                down_indices.append(p)\n",
    "                \n",
    "        # Compute Fermionic sign phase\n",
    "        sign_power = 0\n",
    "        for p_dn in down_indices:\n",
    "            count = sum(1 for p in indices if p > p_dn and p % 2 == 0)\n",
    "            sign_power += count\n",
    "            \n",
    "        sign = 1 if sign_power % 2 == 0 else -1\n",
    "        \n",
    "        i_up = basis_up._mask2idx_cache[int(mask_up)]\n",
    "        j_dn = basis_dn._mask2idx_cache[int(mask_dn)]\n",
    "        \n",
    "        sub2idx[(i_up, j_dn)] = (k, sign)\n",
    "        \n",
    "    return idx_sector_arr, basis_up, basis_dn, sub2idx\n",
    "\n",
    "def sector_negativity(rho_block: np.ndarray, basis_up: FixedBasis, basis_dn: FixedBasis, sub2idx: dict) -> float:\n",
    "    \"\"\"\n",
    "    Maps a block-diagonal density matrix to its specific Tensor Product space, \n",
    "    applies the partial transpose over the DOWN subsystem, and returns its negativity.\n",
    "    \"\"\"\n",
    "    dim_up = basis_up.size\n",
    "    dim_dn = basis_dn.size\n",
    "    \n",
    "    if rho_block.ndim == 1:\n",
    "        rho_block = np.outer(rho_block, rho_block.conj())\n",
    "        \n",
    "    # Preallocate perfectly-sized Tensor Product matrix\n",
    "    rho_TP = np.zeros((dim_up * dim_dn, dim_up * dim_dn), dtype=rho_block.dtype)\n",
    "    \n",
    "    # Vectorized assignment to the TP basis\n",
    "    valid_pairs = list(sub2idx.items())\n",
    "    if not valid_pairs:\n",
    "        return 0.0\n",
    "\n",
    "    tp_idx = [i * dim_dn + j for (i, j), _ in valid_pairs]\n",
    "    fci_idx = [k for _, (k, _) in valid_pairs]\n",
    "    signs = np.array([sign for _, (_, sign) in valid_pairs], dtype=float)\n",
    "    \n",
    "    rho_fci_sub = rho_block[np.ix_(fci_idx, fci_idx)]\n",
    "    rho_TP[np.ix_(tp_idx, tp_idx)] = rho_fci_sub * np.outer(signs, signs)\n",
    "    \n",
    "    # Apply Partial Transpose on the DOWN subsystem\n",
    "    # Reshape: (UP_bra, DOWN_bra, UP_ket, DOWN_ket)\n",
    "    rho_4D = rho_TP.reshape((dim_up, dim_dn, dim_up, dim_dn))\n",
    "    \n",
    "    # Transpose swapping DOWN_bra (axis 1) and DOWN_ket (axis 3)\n",
    "    rho_pt = rho_4D.transpose((0, 3, 2, 1)).reshape((dim_up * dim_dn, dim_up * dim_dn))\n",
    "    \n",
    "    # Calculate Negativity (Sum of the absolute values of the negative eigenvalues)\n",
    "    eigvals = np.linalg.eigvalsh(rho_pt)\n",
    "    negativity = np.sum(np.abs(eigvals[eigvals < -1e-12]))\n",
    "    \n",
    "    return float(negativity)"
   ]

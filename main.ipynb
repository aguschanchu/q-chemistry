    "import scipy.sparse.linalg\n",
    "import scipy.linalg\n",
    "from typing import Dict, Union\n",
    "import numpy as np\n",
    "from tqdm import tqdm\n",
    "\n",
    "def calculate_dissociation_curve(dists: np.ndarray, \n",
    "                                 basis_r: FixedBasis, \n",
    "                                 state_type: str = 'gs', \n",
    "                                 level: int = 0, \n",
    "                                 BETA: float = 1000.0,\n",
    "                                 degeneracy_tol: float = 1e-6) -> Dict[float, Union[np.ndarray, np.ndarray]]:\n",
    "    \"\"\"\n",
    "    Calculates the specified energy level (GS or excited) or thermal state.\n",
    "    Strictly preserves Sz symmetries to avoid unphysical coherences and PT noise.\n",
    "    \"\"\"\n",
    "    states = {}\n",
    "    prev_vecs = None \n",
    "    print(f\"Calculating dissociation curve (Type: {state_type}, Level: {level})...\")\n",
    "    \n",
    "    k_extra = 1 if level != 0 else 0\n",
    "    k_request = level + 1 + k_extra\n",
    "\n",
    "    # --- Pre-compute Sz sectors to enforce block-diagonalization ---\n",
    "    mask_up_spins = sum(1 << i for i in range(0, basis_r.d, 2))\n",
    "    sectors = {}\n",
    "    for idx, ket_mask in enumerate(basis_r.num_ele):\n",
    "        n_up = bin(int(ket_mask) & mask_up_spins).count('1')\n",
    "        if n_up not in sectors:\n",
    "            sectors[n_up] = []\n",
    "        sectors[n_up].append(idx)\n",
    "        \n",
    "    for n_up in sectors:\n",
    "        sectors[n_up] = np.array(sectors[n_up], dtype=np.int64)\n",
    "\n",
    "    for R in tqdm(dists, desc=\"R\"):\n",
    "        R = float(R)\n",
    "        \n",
    "        # Generate Hamiltonian \n",
    "        fop, *_ = generate_h2o_hamiltonian(R)\n",
    "        if fop is None:\n",
    "            fop, *_ = generate_h2o_hamiltonian(R + 1e-4 * np.random.random())\n",
    "            if fop is None:\n",
    "                print(f\"Skipping R={R:.4f}.\")\n",
    "                continue\n",
    "\n",
    "        # Project Hamiltonian\n",
    "        H = basis_r.get_operator_matrix(fop).real\n",
    "\n",
    "        # Calculate State\n",
    "        if state_type == 'gs':\n",
    "            k_eff = min(k_request, H.shape[0] - 1)\n",
    "            if k_eff <= 0: continue\n",
    "\n",
    "            try:\n",
    "                v0 = prev_vecs[:, level] if prev_vecs is not None and prev_vecs.shape[1] > level else None\n",
    "\n",
    "                ncv = max(2 * k_eff + 5, min(H.shape[0] - 1, 40))\n",
    "                E, V = scipy.sparse.linalg.eigsh(H, k=k_eff, which='SA', v0=v0, tol=1e-14, ncv=ncv)\n",
    "                \n",
    "                if len(E) <= level:\n",
    "                    print(f\"Warning: Fewer states ({len(E)}) found than requested level ({level}) at R={R:.4f}.\")\n",
    "                    continue\n",
    "\n",
    "                sort_idx = np.argsort(E)\n",
    "                E = E[sort_idx]\n",
    "                V = V[:, sort_idx]\n",
    "\n",
    "                norms = np.linalg.norm(V, axis=0)\n",
    "                valid_mask = norms > 1e-9\n",
    "                if np.any(valid_mask):\n",
    "                   V_norm = V[:, valid_mask] / norms[valid_mask]\n",
    "                   prev_vecs = V_norm\n",
    "                \n",
    "                # Degeneracy Handling\n",
    "                target_energy = E[level]\n",
    "                degenerate_indices = np.where(np.abs(E - target_energy) < degeneracy_tol)[0]\n",
    "                \n",
    "                if len(degenerate_indices) > 1:\n",
    "                    V_subspace = V[:, degenerate_indices]\n",
    "                    D = V_subspace.shape[1]\n",
    "                    rho_projector = (V_subspace @ V_subspace.conj().T) / D\n",
    "                    states[R] = rho_projector\n",
    "                else:\n",
    "                    states[R] = V[:, level]\n",
    "\n",
    "            except (scipy.sparse.linalg.ArpackNoConvergence, scipy.sparse.linalg.ArpackError) as e:\n",
    "                print(f\"Warning: Eigensolver failed at R={R:.4f} for level {level}. Skipping. Error: {e}\")\n",
    "                prev_vecs = None \n",
    "                continue\n",
    "\n",
    "        elif state_type == 'thermal':\n",
    "            # === Sz Block-Diagonalization ===\n",
    "            all_evals = []\n",
    "            all_evecs = []\n",
    "            \n",
    "            # 1. Diagonalize sector strictly\n",
    "            for n_up, idx_arr in sectors.items():\n",
    "                H_block = H[np.ix_(idx_arr, idx_arr)]\n",
    "                H_dense = H_block.todense() if hasattr(H_block, 'todense') else np.asarray(H_block)\n",
    "                \n",
    "                if H_dense.shape[0] == 0:\n",
    "                    continue\n",
    "                    \n",
    "                E_sec, V_sec = scipy.linalg.eigh(H_dense)\n",
    "                all_evals.append(E_sec)\n",
    "                all_evecs.append((n_up, idx_arr, E_sec, V_sec))\n",
    "                \n",
    "            # 2. Compute global thermal weights tracking the true global GS energy\n",
    "            global_evals = np.concatenate(all_evals)\n",
    "            E_min = global_evals.min()\n",
    "            \n",
    "            # Shift by E_min to prevent float overflow/underflow at high BETA\n",
    "            global_weights = np.exp(-BETA * (global_evals - E_min), dtype=np.float64)\n",
    "            Z = np.sum(global_weights)\n",
    "            \n",
    "            # 3. Reconstruct perfectly block-diagonal density matrix\n",
    "            rho_thermal = np.zeros((basis_r.size, basis_r.size), dtype=np.float64)\n",
    "            \n",
    "            for n_up, idx_arr, E_sec, V_sec in all_evecs:\n",
    "                weights_sec = np.exp(-BETA * (E_sec - E_min), dtype=np.float64) / Z\n",
    "                \n",
    "                # Only perform matmul if the block has physical weight\n",
    "                if np.sum(weights_sec) > 1e-16:\n",
    "                    rho_sec = V_sec @ np.diag(weights_sec) @ V_sec.T.conj()\n",
    "                    # Assign perfectly into the original basis coordinates\n",
    "                    rho_thermal[np.ix_(idx_arr, idx_arr)] = rho_sec\n",
    "                \n",
    "            states[R] = rho_thermal\n",
    "        else:\n",
    "            raise ValueError(f\"Unknown state_type: {state_type}.\")\n",
    "\n",
    "    return states\n",
    "\n",
    "states = calculate_dissociation_curve(dists, basis_r, state_type ='thermal', BETA = BETA)"
   ]

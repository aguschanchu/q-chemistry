    "def plot_sz_resolved_negativity(states_dict: dict, basis_c: FixedBasis, label: str = r'Negativity $\\mathcal{N}_{\\uparrow\\downarrow}$'):\n",
    "    \"\"\"\n",
    "    Calculates the Total Bipartite Negativity of the state by strictly enforcing \n",
    "    particle number superselection rules across all allowed Sz sectors.\n",
    "    \"\"\"\n",
    "    ds = sorted(list(states_dict.keys()))\n",
    "    res = np.zeros(len(ds))\n",
    "    \n",
    "    N_total = basis_c.num\n",
    "    N_spatial = basis_c.d // 2\n",
    "    \n",
    "    print(\"Pre-computing Sz sector mappings...\")\n",
    "    sectors_info = []\n",
    "    \n",
    "    # Evaluate allowed N_up configurations\n",
    "    for n_up in range(max(0, N_total - N_spatial), min(N_total, N_spatial) + 1):\n",
    "        n_dn = N_total - n_up\n",
    "        idx_sector, b_up, b_dn, s2i = get_sector_mappings(basis_c, n_up, n_dn)\n",
    "        \n",
    "        if len(idx_sector) > 0:\n",
    "            sectors_info.append((idx_sector, b_up, b_dn, s2i))\n",
    "            \n",
    "    for idx, R in tqdm(enumerate(ds), total=len(ds), desc=\"Sz-Resolved Negativity\"):\n",
    "        state = states_dict[R]\n",
    "        \n",
    "        if state.ndim == 1:\n",
    "            rho = np.outer(state, state.conj())\n",
    "        else:\n",
    "            rho = state\n",
    "            \n",
    "        total_negativity = 0.0\n",
    "        \n",
    "        # Compute PT negativity independently per Sz block\n",
    "        for idx_sector, b_up, b_dn, s2i in sectors_info:\n",
    "            \n",
    "            # Extract the S_z block from the global state\n",
    "            rho_block = rho[np.ix_(idx_sector, idx_sector)]\n",
    "            \n",
    "            # Optimization: Skip numerically empty blocks (saves extensive time)\n",
    "            if np.trace(rho_block).real < 1e-12:\n",
    "                continue\n",
    "                \n",
    "            total_negativity += sector_negativity(rho_block, b_up, b_dn, s2i)\n",
    "            \n",
    "        res[idx] = total_negativity\n",
    "        \n",
    "    # Plotting\n",
    "    plt.figure()\n",
    "    plt.plot(ds, res, label=label, color='purple')\n",
    "    plt.xlabel(r'$R (\\AA)$', fontsize=16)\n",
    "    plt.ylabel(r'$\\mathcal{N}_{\\uparrow\\downarrow}$', fontsize=16)\n",
    "    plt.grid(alpha=0.3)\n",
    "    plt.legend()\n",
    "    plt.show()\n",
    "    \n",
    "    return res\n",
    "\n",
    "total_thermal_negativity = plot_sz_resolved_negativity(states, basis_r)"
   ]
